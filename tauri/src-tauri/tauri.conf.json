{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pingora",
  "version": "0.1.0",
  "identifier": "io.github.wrestle-r.pingora",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pingora · Connection health",
        "width": 1000,
        "height": 720,
        "minWidth": 600,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false }
}
