<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/pingora_widget_surface">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clipboard" android:textColor="@color/pingora_primary" android:textStyle="bold" android:textSize="16sp" />
    <TextView android:id="@+id/pingora_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" android:text="Ready when your laptop is" android:textColor="@color/pingora_widget_text" android:textSize="13sp" />
    <Button android:id="@+id/pingora_widget_send" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:backgroundTint="@color/pingora_primary" android:textColor="@color/pingora_on_primary" android:textAllCaps="false" android:text="Send clipboard" android:textSize="14sp" />
</LinearLayout>
