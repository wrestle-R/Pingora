<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/pingora_widget_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/laptop_widget_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Your laptop" android:textColor="@color/pingora_widget_text" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/laptop_widget_power" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_profile_balanced" android:contentDescription="Power profile unavailable" />
        <ImageButton android:id="@+id/laptop_widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_refresh_24dp" android:contentDescription="Refresh laptop status" android:background="@android:color/transparent" android:tint="@color/pingora_primary" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/laptop_widget_battery" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="—" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/pingora_primary" />
        <TextView android:id="@+id/laptop_widget_metrics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU —\nRAM —" android:textSize="12sp" android:textColor="@color/pingora_widget_text" />
    </LinearLayout>
    <TextView android:id="@+id/laptop_widget_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for laptop" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/pingora_widget_text" />
    <TextView android:id="@+id/laptop_widget_internet" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Internet unknown" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/pingora_widget_text" />
    <TextView android:id="@+id/laptop_widget_age" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Not synced yet" android:textColor="@color/pingora_widget_text" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" />
    <Chronometer android:id="@+id/laptop_widget_elapsed" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/pingora_widget_text" android:textSize="11sp" android:singleLine="true" />
    <TextView android:id="@+id/laptop_widget_lid" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lid mode unavailable" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/pingora_widget_text" />
</LinearLayout>
